  "vulnerabilities": [
    {
      "cve": "CVE-2023-4527",
      "cwe": { "id": "CWE-125", "name": "Out-of-bounds Read" },
      "discovery_date": "2023-09-12T00:00:00+00:00",
      "notes": [
        {
          "category": "description",
          "text": "A flaw was found in glibc. When the getaddrinfo function is called with the AF_UNSPEC address family, a stack buffer overflow may occur.",
          "title": "Vulnerability description"
        },
        {
          "category": "summary",
          "text": "glibc: Stack read overflow in getaddrinfo in no-aaaa mode",
          "title": "Vulnerability summary"
        },
        {
          "category": "other",
          "text": "This issue did not affect the versions of glibc shipped with Red Hat Enterprise Linux 6 and 7.",
          "title": "Statement"
        }
      ],
      "product_status": {
        "fixed": [
          "BaseOS-8.8.0.Z.MAIN.EUS:glibc-0:2.28-225.el8_8.6.x86_64",
          "BaseOS-8.8.0.Z.MAIN.EUS:glibc-common-0:2.28-225.el8_8.6.x86_64",
          "AppStream-8.8.0.Z.MAIN.EUS:glibc-debuginfo-0:2.28-225.el8_8.6.x86_64"
        ]
      },
      "references": [
        { "category": "self", "summary": "CVE-2023-4527", "url": "https://www.redhat.com/security/data/cve/CVE-2023-4527.html" }
      ],
      "release_date": "2023-09-12T00:00:00+00:00",
      "remediations": [
        {
          "category": "vendor_fix",
          "date": "2023-10-05T14:14:13+00:00",
          "details": "For details on how to apply this update, refer to: https://access.redhat.com/articles/11258",
          "product_ids": ["BaseOS-8.8.0.Z.MAIN.EUS:glibc-0:2.28-225.el8_8.6.x86_64"],
          "url": "https://access.redhat.com/errata/RHSA-2023:5455"
        },
        {
          "category": "workaround",
          "details": "Removing the no-aaaa diagnostic option from /etc/resolv.conf will mitigate this flaw.",
          "product_ids": ["BaseOS-8.8.0.Z.MAIN.EUS:glibc-0:2.28-225.el8_8.6.x86_64"]
        }
